<iconView><layers image="icon/pH-SEN0161-V2_icon.svg"><layer layerId="icon"/></layers></iconView>
<breadboardView><layers image="breadboard/pH-SEN0161-V2_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
