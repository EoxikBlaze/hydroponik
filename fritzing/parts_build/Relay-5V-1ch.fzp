<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.8" moduleId="Relay-5V-1ch" referenceFile="Relay-5V-1ch.fzp">
<version>1.0</version>
<author>HarvestHouse</author>
<title>Modul Relay 5V 1-channel</title>
<label>RELAY</label>
<date>2026-10-10</date>
<url>https://harvesthouse.biz.id</url>
<tags>
<tag>harvesthouse</tag>
<tag>hidroponik</tag>
</tags>
<properties>
<property name="package">SRD-05VDC</property>
<property name="family">relay</property>
</properties>
<description>Relay 5V (firmware: ACTIVE-LOW, RELAY_ON_LEVEL=LOW). IN=GPIO25, koil dari 5V. Sisi beban COM/NO untuk solenoid 12V.</description>
<views>
<iconView><layers image="icon/Relay-5V-1ch_icon.svg"><layer layerId="icon"/></layers></iconView>
<breadboardView><layers image="breadboard/Relay-5V-1ch_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
<schematicView><layers image="schematic/Relay-5V-1ch_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
<pcbView>
<layers image="pcb/Relay-5V-1ch_pcb.svg">
<layer layerId="copper0"/><layer layerId="copper1"/>
<layer layerId="silkscreen"/><layer layerId="outline"/>
</layers>
</pcbView>
</views>
<connectors>
<connector id="connector0" type="male" name="IN">
<description>Input active-LOW dari GPIO25</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector0pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
</views>
</connector>
<connector id="connector1" type="male" name="VCC">
<description>Supply 5V</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
</views>
</connector>
<connector id="connector2" type="male" name="GND">
<description>Ground</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector2pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector2pad"/><p layer="copper1" svgId="connector2pad"/></pcbView>
</views>
</connector>
<connector id="connector3" type="male" name="NO">
<description>Normally open -&gt; + solenoid</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector3pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector3pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector3pad"/><p layer="copper1" svgId="connector3pad"/></pcbView>
</views>
</connector>
<connector id="connector4" type="male" name="COM">
<description>Common -&gt; +12V PSU</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector4pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector4pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector4pad"/><p layer="copper1" svgId="connector4pad"/></pcbView>
</views>
</connector>
<connector id="connector5" type="male" name="NC">
<description>Normally close (tidak dipakai)</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector5pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector5pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector5pad"/><p layer="copper1" svgId="connector5pad"/></pcbView>
</views>
</connector>
</connectors>
</module>
