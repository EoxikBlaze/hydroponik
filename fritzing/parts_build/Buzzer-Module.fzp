<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="1.0.8" moduleId="Buzzer-Module" referenceFile="Buzzer-Module.fzp">
<version>1.0</version>
<author>HarvestHouse</author>
<title>Buzzer Aktif Modul</title>
<label>BUZZER</label>
<date>2026-10-10</date>
<url>https://harvesthouse.biz.id</url>
<tags>
<tag>harvesthouse</tag>
<tag>hidroponik</tag>
</tags>
<properties>
<property name="family">audio</property>
</properties>
<description>Buzzer aktif modul (alarm &amp; feedback suara). IN dari GPIO26; daya dari 3V3 (&lt;=30mA, jaga agar &lt;20mA per pin GPIO).</description>
<views>
<iconView><layers image="icon/Buzzer-Module_icon.svg"><layer layerId="icon"/></layers></iconView>
<breadboardView><layers image="breadboard/Buzzer-Module_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
<schematicView><layers image="schematic/Buzzer-Module_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
<pcbView>
<layers image="pcb/Buzzer-Module_pcb.svg">
<layer layerId="copper0"/><layer layerId="copper1"/>
<layer layerId="silkscreen"/><layer layerId="outline"/>
</layers>
</pcbView>
</views>
<connectors>
<connector id="connector0" type="male" name="GND">
<description>Ground</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector0pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
</views>
</connector>
<connector id="connector1" type="male" name="VCC">
<description>Supply 3.3V</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector1pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
</views>
</connector>
<connector id="connector2" type="male" name="IN">
<description>Input dari GPIO26</description>
<views>
<breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
<schematicView><p layer="schematic" svgId="connector2pin"/></schematicView>
<pcbView><p layer="copper0" svgId="connector2pad"/><p layer="copper1" svgId="connector2pad"/></pcbView>
</views>
</connector>
</connectors>
</module>
